# =============================================================================
# MCAS-ICT backend — environment template
# Copy to .env for local development, or set these as Environment Variables
# in Render (Dashboard → your service → Environment).
# =============================================================================

# Server
PORT=4000
NODE_ENV=development

# Supabase (dashboard → Settings → API).
# The service role key is a SECRET — never expose it to the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated CORS origins allowed to call the API.
#  - Local dev:     http://localhost:5173
#  - Production:    the Vercel frontend URL, e.g. https://mcas-ict.vercel.app
CORS_ORIGIN=http://localhost:5173