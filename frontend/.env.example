# =============================================================================
# MCAS-ICT frontend — environment template
# Copy to .env.local for local development, or set these as Environment
# Variables in Vercel (Settings → Environment Variables).
# =============================================================================

# Supabase project config (Supabase dashboard → Settings → API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend API base URL.
#  - Local dev:     http://localhost:4000
#  - Production:    the Render backend URL, e.g. https://mcas-ict-backend.onrender.com
#        (set CORS_ORIGIN on the backend to the Vercel frontend URL too)
VITE_API_URL=http://localhost:4000